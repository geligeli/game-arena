diff --git a/src/google/protobuf/map_field.h b/src/google/protobuf/map_field.h
--- a/src/google/protobuf/map_field.h
+++ b/src/google/protobuf/map_field.h
@@ -412,8 +412,15 @@
 
   class ReflectionPayload {
    public:
+// patched: protobuf 33.0 deprecates RepeatedPtrField(Arena*) but still uses it
+// here; wrap its own use so consumers building with -Werror (and without -w on
+// external headers) can include this header. Fixed upstream in 34.1 by
+// switching the member to Arena::Create.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
     ReflectionPayload(Arena* arena, const Message* prototype)
         : repeated_field_(arena), prototype_(prototype) {}
+#pragma GCC diagnostic pop
 
     RepeatedPtrField<Message>& repeated_field() { return repeated_field_; }
 
