exports_files(["cpp_format.yaml"])

# The arena a participant's kit builds against: the packages a kit's own
# targets reach, and nothing else. `arena_tournament kit` copies these into
# <kit>/arena and points the kit's MODULE.bazel at them, so a participant gets
# the game side of the arena without the coordinator, the fleet, the sandbox,
# or the tools that decide their score.
#
# Each package here is closed under dependency -- its only in-repo deps are the
# others -- which is what makes this list checkable rather than hopeful:
# //game_arena:kit_surface_test asserts it.
filegroup(
    name = "kit_surface",
    srcs = [
        ".bazelversion",
        "MODULE.bazel",
        "protobuf_bzlmod_fixes.patch",
        "//game_arena/cli:kit_surface_files",
        "//game_arena/client:kit_surface_files",
        "//game_arena/common/kv_options:kit_surface_files",
        "//game_arena/proto:kit_surface_files",
        "//game_arena/referee:kit_surface_files",
        "//game_arena/standings:kit_surface_files",
    ],
    visibility = ["//visibility:public"],
)

# The arena a sandbox image carries, which its bazelrc overrides game_arena
# to: what a participant's kit has, and the macro a problem's root BUILD loads.
filegroup(
    name = "sandbox_surface",
    srcs = [
        ":kit_surface",
        "//game_arena/rules:sandbox_surface_files",
    ],
    visibility = ["//visibility:public"],
)
