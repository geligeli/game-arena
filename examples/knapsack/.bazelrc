# The toolchain comes with game_arena; the sandbox image has no host compiler to detect.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

build --cxxopt='-std=c++23'
build --host_cxxopt='-std=c++23'
build --copt=-fdiagnostics-color=always

build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Werror
build --host_cxxopt=-Wall
build --host_cxxopt=-Wextra
build --host_cxxopt=-Werror
build --per_file_copt='external/.*@-w'
build --host_per_file_copt='external/.*@-w'
build --cxxopt=-Wno-deprecated-attributes
build --host_cxxopt=-Wno-deprecated-attributes
# protobuf 33.0's map_field.h uses what it deprecates, and game_arena's patch
# (a single_version_override) acts only in its own root. Off until protobuf 34.1.
build --cxxopt=-Wno-deprecated-declarations
build --host_cxxopt=-Wno-deprecated-declarations

# Everywhere a submission is built, so what a participant measures is what is played.
build -c opt

# Read in the sandbox image and every kit: host-specific settings go in .bazelrc.local.
try-import %workspace%/.bazelrc.local
