build --cxxopt='-std=c++23'
build --host_cxxopt='-std=c++23'
build --copt=-fdiagnostics-color=always

# Warnings are fatal for this repo's own files; external code is silenced.
build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Werror
build --host_cxxopt=-Wall
build --host_cxxopt=-Wextra
build --host_cxxopt=-Werror
build --per_file_copt='external/.*@-w'
build --host_per_file_copt='external/.*@-w'

# Nothing host-specific above: this file is read inside the sandbox image and
# in every participant's kit. A shared disk cache, a local game_arena override
# and the like go in .bazelrc.local, which is uncommitted.
try-import %workspace%/.bazelrc.local
