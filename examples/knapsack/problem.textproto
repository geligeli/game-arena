# The graded shape: the arena builds a submission, runs grade.argv, and reads
# the numbers it leaves in $ARENA_REPORT.

problem_id: "knapsack"
display_name: "Knapsack"
description:
  "Pack items into a knapsack. Each instance is `N C` followed by N lines of "
  "`value weight`; take items whose total weight is at most C and whose total "
  "value is as high as possible.\n"
  "\n"
  "A submission is one `cc_binary` named `solve` under "
  "`solutions/<your-id>/`. It takes an instance path as its only argument and "
  "prints the indices of the items it packs, one per line.\n"
  "\n"
  "Score is the mean percentage of the known optimum across all cases, so 100 "
  "is exact. An infeasible answer -- over capacity, a repeated index, junk on "
  "stdout -- scores zero for that case; a crash or a timeout does too.\n"

# Every label is relative to this directory, where a worker runs bazel.
submission {
  max_patch_bytes: 262144
  max_files: 16
  # Not the grader, and not the cases it is scored on.
  allow_paths: "solutions/{submission_id}/**"

  files_submit_dir: "solutions"
  harness {
    # A standalone program: the submission's own source is the main.
    api_dep: "@game_arena//game_arena/grader:report"
    main_src: "solve.cc"
    # What build.targets and grade.argv expect.
    binary_name: "solve"
  }
}

build {
  targets: "//solutions/{submission_id}:solve"
  targets: "//grader:grade"
  timeout_s: 600
}

sandbox {
  # What a worker asks its daemon for, as `bazel build //:sandbox_image` makes it.
  image: "registry.takumi.city/knapsack-sandbox:1"
  # Nothing is vendored into that image. A build that can fetch can also exfiltrate.
  allow_build_network: true
  # Not root: unpacking a fetched archive as root restores owners, which a sandbox cannot.
  run_as_user: "1000:1000"
  memory_limit_mb: 4096
}

# Copied to <submit dir>/<your name>/ the first time.
kit {
  starter_dir: "solutions/reference"
}

grade {
  argv: "bazel-bin/grader/grade"
  argv: "--solution=bazel-bin/solutions/{submission_id}/solve"
  argv: "--cases=cases"
  # Deterministic; a problem measuring time would raise this.
  repeats: 1
  aggregate: MIN
  metrics {
    name: "score"
    direction: MAXIMIZE
    primary: true
  }
  metrics {
    name: "solved"
    direction: MAXIMIZE
  }
  metrics {
    name: "infeasible"
    direction: MINIMIZE
  }
  timeout_s: 300
}

ranking {
  kind: METRIC
  metric_name: "score"
}

clients {
  default_quota {
    max_active_evaluations: 1
    max_queued_jobs: 4
  }
}
