# Every label is relative to this directory, where a worker runs bazel.

problem_id: "connect4"
display_name: "Connect Four"
description:
  "Write a Connect Four bot and have it rated against every other "
  "submission.\n"
  "\n"
  "Submit one header defining:\n"
  "\n"
  "    auto ChooseColumn(const bot::Board &board, std::mt19937 &gen) -> int;\n"
  "\n"
  "Start from `bots/reference/strategy.h`. Return a column 0-6 with room in "
  "it; an illegal move loses the game on the spot, because the referee "
  "validates every action.\n"
  "\n"
  "You are placed against `builtin:random` and `builtin:greedy` first, then "
  "matched against other submissions.\n"

submission {
  max_patch_bytes: 262144
  max_files: 16
  allow_paths: "bots/{submission_id}/**"

  # The generated BUILD is what keeps allowed_dep_prefixes enforceable.
  files_submit_dir: "bots"
  harness {
    api_dep: "//bots:bot_api"
    main_src: "//bots:bot.cc"
    bot_deps: "//bots:bot_deps"
  }

  # The rules and nothing else: not the arena, the referee or another submission.
  allowed_dep_prefixes: "//game:connect4"
}

build {
  # The referee too: a submission that breaks the rules fails to build.
  targets: "//bots/{submission_id}:bot"
  targets: "//:match_referee"
  timeout_s: 1200
}

sandbox {
  # What a worker asks its daemon for, as `bazel run //:sandbox_image_issue` makes it.
  image: "registry.takumi.city/connect4-sandbox:latest"
  # So a build needs no network, and a submitted genrule cannot exfiltrate.
  allow_build_network: false
  # Owns the image's primed cache, which fills a worker's empty cache volume.
  run_as_user: "1000:1000"
  memory_limit_mb: 4096
}

match {
  game: "connect4"
  referee_target: "//:match_referee"
  games_per_order: 10
  placement_opponents: "builtin:random"
  placement_opponents: "builtin:greedy"
  turn_timeout_ms: 5000
  # Without it, a slow strategy can spend the full turn budget on each of 42 moves.
  game_time_budget_ms: 60000
  max_moves_per_game: 100
  timeout_s: 900
}

# Copied to <submit dir>/<your name>/ the first time.
kit {
  starter_dir: "bots/reference"
}

ranking { kind: ELO }

clients {
  default_quota {
    max_active_evaluations: 1
    max_queued_jobs: 4
  }
}
