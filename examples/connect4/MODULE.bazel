# A worked example: a two-player tournament problem with its own game.
#
# Its own bazel workspace, not part of game-arena's build, because that is what
# a real problem repo is. Nothing in the arena knows this game exists: the rules
# reach it by linking //game:registry into a referee binary.

module(
    name = "connect4_problem",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "googletest", version = "1.17.0.bcr.1")
bazel_dep(name = "abseil-cpp", version = "20250814.1")
bazel_dep(name = "grpc", version = "1.74.1")

bazel_dep(name = "game_arena", version = "0.1.0")
local_path_override(
    module_name = "game_arena",
    path = "../..",
)

# The kit base with coding agents (docker/coding-agents), in place of the
# arena's own kit_base.
bazel_dep(name = "rules_oci", version = "2.3.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "kit_agents",
    digest = "sha256:b4c50a1e41d5578c3e4b2d99ce203a71ff7346ad66864e32d1b90e163198c99b",
    image = "registry.takumi.city/game-arena-kit-agents",
)
use_repo(oci, "kit_agents")
