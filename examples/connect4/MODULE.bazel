# A worked example: a two-player tournament problem with its own game.
#
# Its own bazel workspace, not part of game-arena's build, because that is what
# a real problem repo is. Nothing in the arena knows this game exists: the rules
# reach it by linking //game:registry into a referee binary.

module(
    name = "connect4_problem",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "abseil-cpp", version = "20250814.1")
bazel_dep(name = "grpc", version = "1.74.1")

bazel_dep(name = "game_arena", version = "0.1.0")
local_path_override(
    module_name = "game_arena",
    path = "../..",
)
