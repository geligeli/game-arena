# The arena's own problem, on the arena's own game.
#
# It ships for two reasons: shipped_problems_test needs a config to prove the
# parser still works, and a new problem needs a worked example that does not
# assume a game framework. Everything here is arena-local -- no label in this
# file points outside this repo.
#
#   bazel run //game_arena/server:problem_server -- \
#       --problem_config=$PWD/game_arena/problems/nim.textproto \
#       --data_dir=$PWD/tournament_data --clients=$PWD/clients.textproto

problem_id: "nim"
display_name: "Nim (21 stones)"
description:
  "Take 1 to 3 stones a turn; whoever takes the last stone wins.\n"
  "\n"
  "The arena's reference problem. Nim is solved, so this is not a strategy "
  "competition -- it exists so the arena can be run end to end without a game "
  "framework in the build.\n"

submission {
  max_patch_bytes: 262144
  max_files: 32
  # Patch-only: the reference problem has no candidate harness to compile
  # submissions against, which is exactly what an unset `harness` means.
  allow_paths: "game_arena/candidates/**"
}

build {
  targets: "//game_arena/testgame:match_referee"
  timeout_s: 600
}

sandbox {
  # A tag of this problem's own, and a local one: `bazel run //:sandbox_image`
  # makes it on this host, and `play` does that for you the first time. To
  # deploy, name it where the arena host can pull it from
  # (registry.example.com/nim-sandbox:1) and commit that -- this name, not a
  # flag, is what a worker asks its daemon for. Never a tag something else
  # already owns: `sandbox_image` writes to whatever this names.
  image: "nim-sandbox:1"
  memory_limit_mb: 2048
  network: NETWORK_INTERNAL_BRIDGE
}

match {
  game: "nim"
  referee_target: "//game_arena/testgame:match_referee"
  games_per_order: 10
  placement_opponents: "builtin:random"
  placement_opponents: "builtin:optimal"
  turn_timeout_ms: 5000
  game_time_budget_ms: 60000
  max_moves_per_game: 100
  timeout_s: 600
}

ranking { kind: ELO }
