# The sandbox image's /etc/bazel.bazelrc. No compiler in the image to detect.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
# A host path to game_arena means nothing in here.
common --override_module=game_arena=/opt/arena/src/game_arena
# A fixed PATH in action keys, so a cache primed outside the image hits in it.
build --incompatible_strict_action_env
# Added by sandbox_image_issue: the vendored dependencies.
try-import /opt/arena/primed.bazelrc
