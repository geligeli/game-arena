# The sandbox image's system bazelrc (/etc/bazel.bazelrc).
#
# System rc rather than the problem's bazel_flags: a worker's bazel invocation
# is the problem's business, and this is the image's.

# There is no compiler in the image, and bazel must not go looking for one:
# without this it autoconfigures a host toolchain repository it never uses and
# fails when there is nothing to find.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# The arena the problem was built with, in place of wherever the problem's
# MODULE.bazel finds it: a path on the host that made the image means nothing
# in here.
common --override_module=game_arena=/opt/arena/src/game_arena
