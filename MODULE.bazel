# MODULE.bazel

module(
    name = "game_arena",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_cc", version = "0.2.25")

# The C++ toolchain: hermetic-llvm (clang + libc++ + compiler-rt, no sysroot).
# Registered here rather than in each consumer so that a problem repo, a kit
# and the sandbox image all compile with the same pinned compiler: ratings are
# only comparable across submissions built the same way, and this makes the
# compiler part of MODULE.bazel.lock instead of whatever the image's distro
# ships. A root module's own registrations take precedence, so a consumer can
# still override it.
bazel_dep(name = "llvm", version = "0.8.21")
register_toolchains("@llvm//toolchain:all")

# Images are layered by bazel, not built by docker: rules_oci stacks tars on a
# base it pulls by digest and never runs anything inside it, so making one
# needs no daemon. What a build cannot hold -- a token, the result of running
# bazel, a git history -- is added to the built image outside the build, as
# more layers. The one thing that does need a container to be made
# -- `apt-get`, and the bazel binary beside it -- is the base itself,
# docker/base/Dockerfile, built by hand and rarely and pinned here. The tag is
# for people; only the digest is used. Pulled lazily: nothing fetches it but a
# target that layers on it (//game_arena/image:kit_base), and those are tagged
# manual so that `//...` -- a consumer's, a kit's, a sandbox's `bazel vendor`
# -- never needs the registry.
bazel_dep(name = "rules_oci", version = "2.3.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "arena_base",
    digest = "sha256:e65008b7817ed904b2ca07c744703283edd92166d0d004e6590d839b22321b2d",
    image = "registry.takumi.city/game-arena-base",
    # tag = "noble-bazel8.8.0"
)
use_repo(oci, "arena_base")

# The docker CLI a tournament image carries: its workers start every build and
# every match as a container on the daemon whose socket is mounted in. A static
# binary, so a layer like any other; the archive's daemon and containerd are
# left behind. Fetched only by a target that builds a tournament image.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "arena_docker_cli",
    build_file_content = 'exports_files(["docker"])',
    sha256 = "cc21815cf1e2efed867dc9c8b96b46ffed8ea176ffab32b0aacb54726ded8f25",
    strip_prefix = "docker",
    urls = ["https://download.docker.com/linux/static/stable/x86_64/docker-29.8.0.tgz"],
)

# game_arena/server:no_problem_code_test is an sh_test.
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.1")

# game_arena/sandbox/worker:build_log parses bazel output with RE2.
bazel_dep(name = "re2", version = "2025-11-05.bcr.1")
bazel_dep(name = "abseil-cpp", version = "20250814.1")
bazel_dep(name = "protobuf", version = "33.0")
bazel_dep(name = "grpc", version = "1.74.1")

# Already in the graph through grpc and boost.asio; declared directly so the
# arena's client registry can hash tokens with SHA-256 rather than carry its own
# copy of one. Version matched to the highest any of them asks for -- boost.asio
# is currently that one -- so this adds no new fetch and no version warning.
bazel_dep(name = "boringssl", version = "0.20251002.0")

# The leaderboard's embedded HTTP server (//game_arena/standings:http_leaderboard).
# Beast is header-only and brings Asio with it; between them they own the socket,
# the request parser and the response framing, which is the whole of what that
# server used to hand-roll over POSIX sockets. Boost.JSON does the same for the
# /api responses: building them by concatenation is what made a hand-written
# escaper necessary in the first place.
bazel_dep(name = "boost.asio", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.beast", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.json", version = "1.90.0.bcr.1")

# protobuf_bzlmod_fixes.patch works around two bzlmod problems in protobuf
# 33.0; all hunks only touch machinery Bazel consumers cannot use anyway
# (building protobuf's own wheels, the unsupported fast-C++-protos extension):
#
# - https://github.com/protocolbuffers/protobuf/issues/22386:
#   @protobuf//python/dist loads @protobuf_pip_deps//:requirements.bzl, but
#   that repo is only created by a dev_dependency extension, so it is missing
#   when protobuf is not the root module. Dropped, along with the matching
#   @system_python//:version.bzl load.
# - https://github.com/protocolbuffers/protobuf/issues/24084: since 33.0 the
#   @system_python repo (and the wheel-only @python-3.9.0 / @nuget_python_*
#   header repos) come from a dev_dependency extension, but
#   //python:protobuf_python -- the runtime of every py_proto_library --
#   reaches targets that reference them through select()s, and deps() queries
#   (//game_arena:kit_surface_deps) resolve every branch. Defining the repo in
#   this MODULE.bazel does not help: bzlmod repo visibility is per-module, so
#   @@protobuf+ cannot see the root module's repos (verified empirically). The
#   patch drops the references instead.
# - 33.0 also marks RepeatedPtrField(Arena*) deprecated while map_field.h
#   still uses it, which our -Werror builds cannot include; wrapped in a
#   diagnostic pragma. Fixed upstream in 34.1.
single_version_override(
    module_name = "protobuf",
    patches = ["//:protobuf_bzlmod_fixes.patch"],
    patch_strip = 1,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

# Runtime deps for the arena MCP server (mcp_servers/requirements.txt). The hub
# name carries the module name because pip hub names are global: a consumer
# with its own MCP servers would otherwise collide with this one.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "arena_mcp_pip_deps",
    python_version = "3.12",
    requirements_lock = "//mcp_servers:requirements.txt",
)
use_repo(pip, "arena_mcp_pip_deps")


# C++ formatting (//tools/cpp_format.sh). Dev-only, and deliberately so: it is
# not in the BCR, so it can only be resolved through the archive_override below,
# and an override only has effect in the root module. A repo that depends on
# game_arena (examples/connect4, a participant's kit) would otherwise fail to
# resolve the module graph at all. dev_dependency drops the bazel_dep and the
# extension for every module that isn't the root, which is exactly the set of
# builds that never run the formatter. No BUILD file here references
# @cpp_format_bin, so nothing in the build graph misses it.
bazel_dep(name = "cpp_formatting", version = "0.1.0", dev_dependency = True)

CPP_FORMAT_VERSION = "20260920-d26f1b4"

archive_override(
    module_name = "cpp_formatting",
    urls = ["https://github.com/geligeli/cpp_formatting/archive/refs/tags/" + CPP_FORMAT_VERSION + ".tar.gz"],
    strip_prefix = "cpp_formatting-" + CPP_FORMAT_VERSION,
)

cpp_format = use_extension(
    "@cpp_formatting//bazel/integration:extensions.bzl",
    "cpp_format",
    dev_dependency = True,
)
cpp_format.release(
    version = CPP_FORMAT_VERSION,
    # Optional but recommended for reproducible CI — pin per-asset hashes:
    # sha256 = {"cpp_format-linux-x86_64": "…"},
)
use_repo(cpp_format, "cpp_format_bin")

