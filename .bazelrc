# The toolchain is hermetic-llvm; a host autoconfig fails where no compiler is installed.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

build --cxxopt='-std=c++23'
build --host_cxxopt='-std=c++23'
build --copt=-fdiagnostics-color=always
# Selects googletest's :has_absl (absl flags and failure signal handler in gtest).
build --define=absl=1

# Shared caches, at the same path on the host and in the devcontainer.
common --disk_cache=/large_nfs/bazel-cache/disk
common --repository_cache=/large_nfs/bazel-cache/repo

# The disk cache never expires on its own; an idle server collects it (LRU).
common --experimental_disk_cache_gc_max_size=50G

build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Werror
build --host_cxxopt=-Wall
build --host_cxxopt=-Wextra
build --host_cxxopt=-Werror
build --per_file_copt='external/.*@-w'
build --host_per_file_copt='external/.*@-w'
# -w cannot reach an external header included from project code: abseil
# 20250814 spells lifetime_capture_by(this) the way clang 23 deprecates.
build --cxxopt=-Wno-deprecated-attributes
build --host_cxxopt=-Wno-deprecated-attributes

# Each config's --platform_suffix keeps its outputs apart, so switching discards nothing.
build:native --platform_suffix=native
build:native --copt=-march=native

# No msan config: hermetic-llvm 0.8 ships no msan-instrumented libc++, so msan
# reports uninitialized reads inside std::string before main().
build:asan --platform_suffix=asan
build:asan --strip=never
build:asan --@llvm//config:asan=true
build:asan --copt=-O0
build:asan --copt=-g
build:asan --action_env=ASAN_OPTIONS=detect_leaks=1:color=always

build:tsan --platform_suffix=tsan
build:tsan --strip=never
build:tsan --@llvm//config:tsan=true
build:tsan --action_env=TSAN_OPTIONS=halt_on_error=1:second_deadlock_stack=1

build:ubsan --platform_suffix=ubsan
build:ubsan --strip=never
build:ubsan --@llvm//config:ubsan=true
build:ubsan --copt=-O0
build:ubsan --action_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1

# Uncommitted. Without /large_nfs: `common --disk_cache=` and `common --repository_cache=`.
try-import %workspace%/.bazelrc.local
